# ==============================================================================
# Multi-Tenant Agent Platform - Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=3000

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting (per user per minute on chat endpoint)
RATE_LIMIT_PER_MINUTE=20

# Relational Database
# Defaults to absolute SQLite path for seamless zero-dependency local runs.
# Postgres example: postgresql+asyncpg://postgres:postgres@localhost:5432/platform_db
DATABASE_URL=sqlite+aiosqlite:///./platform.db
SYNC_DATABASE_URL=sqlite:///./platform.db

# LLM Provider Configuration
# Switchable between: "mock" (offline default, no keys needed), "gemini", or "mistral"
LLM_PROVIDER=mock

# Google Gemini API (Free tier from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral AI API (Free Experiment plan)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Studio Timezone (Org B: Lotus Wellness Studio)
STUDIO_TIMEZONE=Asia/Kathmandu
