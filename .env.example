# ==============================================================================
# Multi-Tenant Agent Platform: environment variables
# Copy to .env (`cp .env.example .env`). .env is git-ignored; never commit real keys.
# Every variable the application reads is listed here.
# ==============================================================================

# ---- Application -------------------------------------------------------------
APP_ENV=development

# ---- Security and sessions ---------------------------------------------------
# REQUIRED. Signs session tokens. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-32-byte-hex-string
ALGORITHM=HS256
# Session lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# bcrypt work factor. Keep 12 or higher outside tests.
BCRYPT_ROUNDS=12
# Chat endpoint limit, per signed-in user per minute
RATE_LIMIT_PER_MINUTE=20
# Login and sign-up attempts per client address and email per minute
AUTH_RATE_LIMIT_PER_MINUTE=10
# Browser origins allowed to call the API (comma separated). The Docker setup serves the UI and API from one origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ---- Relational database -----------------------------------------------------
# Defaults to backend/platform.db (SQLite), so nothing needs setting for local runs.
# DATABASE_URL=sqlite+aiosqlite:///./backend/platform.db
# SYNC_DATABASE_URL=sqlite:///./backend/platform.db
# Postgres would be:  postgresql+asyncpg://user:pass@localhost:5432/platform_db
# Milliseconds a writer waits for the SQLite write lock before the request gets HTTP 409
SQLITE_BUSY_TIMEOUT_MS=5000

# ---- Vector store ------------------------------------------------------------
# Folder of the persistent Chroma collection. Defaults to backend/chroma_data.
# CHROMA_PATH=./backend/chroma_data

# ---- Chat model (switchable) -------------------------------------------------
# mock    deterministic rule-based stand-in for offline demos and the eval suite (not a language model)
# gemini  Google AI Studio free tier (needs GEMINI_API_KEY)
# mistral Mistral Experiment plan (needs MISTRAL_API_KEY)
# groq    Groq free tier, OpenAI-compatible, fast (needs GROQ_API_KEY from console.groq.com)
# ollama  a local model, no key and no quota (install Ollama, then `ollama pull llama3.1:8b`)
# A key alone never switches the provider; set LLM_PROVIDER explicitly.
LLM_PROVIDER=mock
# Pause between tokens of the mock model, so streaming and the Stop button are visible in a demo (0 = off)
MOCK_TOKEN_DELAY_MS=25

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ---- Embeddings and retrieval ------------------------------------------------
# gemini  Gemini Embedding 2 vectors in Chroma (needs GEMINI_API_KEY)
# bm25    offline lexical retrieval over the same chunks (no key, no network)
# Re-run `make seed` after changing this so the vectors are rebuilt.
EMBEDDING_PROVIDER=bm25
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Relevance floors. A passage below these is not returned, so unanswerable questions get no citation.
KB_MIN_SIMILARITY=0.66
KB_BM25_MIN_COVERAGE=0.5
